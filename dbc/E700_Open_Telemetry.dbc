// Windrose E700 — Open Telemetry CAN Database / 开放遥测数据库
// SPDX-License-Identifier: Apache-2.0
//
// WHAT THIS IS / 这是什么
//   The read channel only: signals the vehicle broadcasts about its own state.
//   仅读通道：车辆广播的自身状态信号。
//
// WHAT IS DELIBERATELY NOT HERE / 刻意不包含的内容
//   - Command messages (torque / speed / gear / gate commands)  控制指令报文
//   - Diagnostic services, security access, flashing            诊断服务、安全访问、刷写
//   - Checksum and rolling-counter definitions                  校验和与滚动计数定义
//   - Third-party supplier diagnostic specifications            外购件供应商诊断规范
//   Reading a vehicle never changes it. Commanding one does. This file is the read half.
//   读一台车不会改变它，命令它会。本文件只是读的那一半。
//
// Vehicle: Windrose E700 heavy electric tractor platform
// Buses:   classic CAN 500 kbit/s and CAN FD (500k arbitration / 2 Mbit/s data)
// Source:  E700 platform communication matrix
//
// Interfaces are read-only by design. Configure any tool in listen-only / silent mode.

VERSION "E700 Open Telemetry"

NS_ :
	NS_DESC_
	CM_
	BA_DEF_
	BA_
	VAL_
	CAT_DEF_
	CAT_
	FILTER
	BA_DEF_DEF_
	EV_DATA_
	ENVVAR_DATA_
	SGTYPE_
	SGTYPE_VAL_
	BA_DEF_SGTYPE_
	BA_SGTYPE_
	SIG_TYPE_REF_
	VAL_TABLE_
	SIG_GROUP_
	SIG_VALTYPE_
	SIGTYPE_VALTYPE_
	BO_TX_BU_
	BA_DEF_REL_
	BA_REL_
	BA_DEF_DEF_REL_
	BU_SG_REL_
	BU_EV_REL_
	BU_BO_REL_
	SG_MUL_VAL_

BS_:

BU_: CDCU EBS MCU1 MCU2 MCU3 MCU4 PDU TCU_A VDC

